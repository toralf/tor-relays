# {{ ansible_managed }}

/var/log/tor/*.log {
  daily
  maxsize 10M
  rotate 5
  delaycompress
  missingok
  notifempty
  create 0640 {{ tor_build_from_source | ternary('tor tor', 'debian-tor adm') }}
  sharedscripts
  postrotate
    if invoke-rc.d tor status >/dev/null; then
      invoke-rc.d tor reload >dev/null
    fi
  endscript
}

# Tor dump files
/var/log/tor/*.log-???????? {
  hourly
  rotate 5
  delaycompress
  missingok
  notifempty
  create 0640 {{ tor_build_from_source | ternary('tor tor', 'debian-tor adm') }}
}
