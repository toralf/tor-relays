#!/usr/bin/env bash
# set -x
# {{ ansible_managed }}

function clearAll() {
  $ipt -P INPUT ACCEPT
  $ipt -F INPUT
  $ipt -Z INPUT
}

function addRules() {
  # allow loopback
  $ipt -A INPUT --in-interface lo -m comment --comment "Firewall IPv4 $(date -R)" -j ACCEPT

  # do not touch established connections
  $ipt -A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  $ipt -A INPUT -m conntrack --ctstate INVALID -j DROP

  # make sure NEW incoming tcp connections are SYN packets
  $ipt -A INPUT -p tcp ! --syn -m conntrack --ctstate NEW -j DROP

  # ssh
  $ipt -A INPUT -p tcp --dport 22 --syn -j ACCEPT

  #  PMTUD
  $ipt -A INPUT -p icmp --icmp-type destination-unreachable -j ACCEPT
  $ipt -A INPUT -p icmp --icmp-type time-exceeded -j ACCEPT
  $ipt -A INPUT -p icmp --icmp-type parameter-problem -j ACCEPT

  # ping
  $ipt -A INPUT -p icmp --icmp-type echo-request -m limit --limit 6/s --limit-burst 10 -j ACCEPT

  # DHCPv4
  $ipt -A INPUT -p udp --dport 68 -j ACCEPT
{% if metrics_port > 0 and prometheus_server_v4 | length > 0 %}

  # Prometheus scrape metrics
  $ipt -A INPUT -p tcp --src {{ prometheus_server_v4 }} --dst {{ ansible_facts.default_ipv4.address }} --dport {{ metrics_port }} --syn -j ACCEPT
{%endif %}
{% if ingress_ports | length > 0 %}

  hashlimit_opts="--hashlimit-mode srcip,dstport --hashlimit-htable-max $max --hashlimit-htable-size $((max / 4)) --hashlimit-srcmask 32"
{% for _i in ingress_ports %}

  # additional port {{ _i }}
{% if _i is search(',') or _i is search(':') %}
  $ipt -A INPUT -p tcp --dst {{ ansible_facts.default_ipv4.address }} --match multiport --dports {{ _i }} -m hashlimit $hashlimit_opts --hashlimit-name port-{{ _i }} --hashlimit-above 60/minute --hashlimit-burst 10 --hashlimit-htable-expire $((2 * 60 * 1000)) -j DROP
  $ipt -A INPUT -p tcp --dst {{ ansible_facts.default_ipv4.address }} --match multiport --dports {{ _i }} --syn -j ACCEPT
{% else %}
  $ipt -A INPUT -p tcp --dst {{ ansible_facts.default_ipv4.address }} --dport {{ _i }} -m hashlimit $hashlimit_opts --hashlimit-name port-{{ _i }} --hashlimit-above 60/minute --hashlimit-burst 10 --hashlimit-htable-expire $((2 * 60 * 1000)) -j DROP
  $ipt -A INPUT -p tcp --dst {{ ansible_facts.default_ipv4.address }} --dport {{ _i }} --syn -j ACCEPT
{% endif %}
{% endfor %}
{% endif %}

  $ipt -P INPUT DROP
}

#######################################################################
set -euf

ipt="iptables"

modprobe nf_conntrack
# see https://github.com/toralf/torutils/blob/main/ipv4-rules.sh#L300
max={{ (ansible_facts.memtotal_mb < 1024) | ternary(2**18, 2**19) }}
sysctl -w net.netfilter.nf_conntrack_buckets=$max >/dev/null
sysctl -w net.netfilter.nf_conntrack_max=$max >/dev/null

trap clearAll INT QUIT TERM EXIT
if [[ $1 == "start" ]]; then
  clearAll
  addRules
else
  $1
fi
trap - INT QUIT TERM EXIT
