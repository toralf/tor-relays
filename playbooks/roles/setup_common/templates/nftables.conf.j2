# {{ ansible_managed }}

{% set _setsize = (ansible_facts.memtotal_mb < 1024) | ternary(2**18, 2**20) %}
flush ruleset

# (IPv4 & IPv6)
table inet ingress_filter {
    define local_address_v4 = {{ ansible_facts.default_ipv4.address }}
    define local_address_v6 = [{{ ansible_facts.default_ipv6.address }}]
    define network_v4_block = 255.255.255.255
    define network_v6_block = [ffff:ffff:ffff:ffff::]

    # ICMP & Network Control Filters
    chain icmp_filter {
        # ICMPv4: Allow essential error messages
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept

        # ICMPv4: Allow inbound ping with rate limiting
        ip protocol icmp icmp type echo-request limit rate 6/second burst 10 packets accept

        # IPv6: Allow basic Link-Local and Multicast infrastructure traffic
        ip6 saddr fe80::/10 ip6 daddr ff02::/16 accept

        # ICMPv6: Allow essential error and control messages (e.g., Packet Too Big for PMTUD)
        ip6 nexthdr ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

        # ICMPv6: Allow inbound ping with rate limiting
        ip6 nexthdr ipv6-icmp icmpv6 type echo-request limit rate 6/second burst 10 packets accept

        # IPv6: Allow Neighbor Discovery Protocol (NDP - Crucial for IPv6 address resolution)
        ip6 nexthdr ipv6-icmp icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

        # IPv6: Allow Multicast Listener Discovery (MLD - Critical for local IPv6 stability; hoplimit 1 enforced)
        ip6 nexthdr ipv6-icmp icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-reduction, mld2-listener-report } \
            ip6 hoplimit 1 accept
    }

    # ======== ADDITIONAL BEGIN ========
{% if inventory_hostname == 'elster4' %}

    #   e.g. Hetzner monitoring server:
    #   getent ahostsv4 pool.sysmon.hetzner.com | awk '{ print $1 }' | sort -uV | xargs -r | sed 's/ /, /g'
    counter hetzner_v4    { packets 0 bytes 0 }
    set hetzner_v4 {
        type ipv4_addr
        elements = {
            188.40.24.211, 213.133.113.82, 213.133.113.83, 213.133.113.84, 213.133.113.86
        }
    }
    #   getent ahostsv6 pool.sysmon.hetzner.com | awk '{ print $1 }' | sort -uV | xargs -r | sed 's/ /, /g'
    counter hetzner_v6    { packets 0 bytes 0 }
    set hetzner_v6 {
        type ipv6_addr
        elements = {
            2a01:4f8:0:a101::5:1, 2a01:4f8:0:a101::6:1, 2a01:4f8:0:a101::6:2, 2a01:4f8:0:a101::6:3, 2a01:4f8:0:a112::c:1
        }
    }
{% endif %}
{% for _i in ingress_ports %}

    # Open port(s) { {{ _i }} }
    counter ports_v4_{{ loop.index }} { packets 0 bytes 0 }
    set ports_v4_{{ loop.index }} {
        type ipv4_addr . inet_service
        flags dynamic, timeout
        timeout 5m
        size {{ _setsize }}
    }
    counter ports_v6_{{ loop.index }} { packets 0 bytes 0 }
    set ports_v6_{{ loop.index }} {
        type ipv6_addr . inet_service
        flags dynamic, timeout
        timeout 5m
        size {{ _setsize }}
    }
{% endfor %}

    chain additional {
{% if allow_metrics_port and prometheus_server_v4 | length > 0 %}

        # Prometheus
        define metrics_port  = { {{ metrics_port }} }
        define prometheus_v4 = {{ prometheus_server_v4 }}
        define prometheus_v6 = [{{ prometheus_server_v6 }}]

        ip saddr $prometheus_v4 ip daddr $local_address_v4 tcp dport $metrics_port ct state new counter accept
        ip6 saddr $prometheus_v6 ip6 daddr $local_address_v6 tcp dport $metrics_port ct state new counter accept
{% endif %}
{% if inventory_hostname == 'elster4' %}

        # Hetzner monitoring
        ip saddr @hetzner_v4 ct state new counter name "hetzner_v4" accept
        ip6 saddr @hetzner_v6 ct state new counter name "hetzner_v6" accept
{% endif %}
{% for _i in ingress_ports %}

        # Open port(s) { {{ _i }} }
        ip daddr $local_address_v4 tcp dport { {{ _i }} } ct state new \
            add @ports_v4_{{ loop.index }} { ip saddr & $network_v4_block . tcp dport limit rate over 20/minute burst 10 packets } \
            counter name "ports_v4_{{ loop.index }}" drop

        ip6 daddr $local_address_v6 tcp dport { {{ _i }} } ct state new \
            add @ports_v6_{{ loop.index }} { ip6 saddr & $network_v6_block . tcp dport limit rate over 20/minute burst 10 packets } \
            counter name "ports_v4_{{ loop.index }}" drop

        ip daddr $local_address_v4 tcp dport { {{ _i }} } ct state new counter accept
        ip6 daddr $local_address_v6 tcp dport { {{ _i }} } ct state new counter accept
{% endfor %}
    }
    # ======== ADDITIONAL END ========

    # Tarpit
    counter tarpit_v4_drop  { packets 0 bytes 0 }
    counter tarpit_v4_addr  { packets 0 bytes 0 }
    set tarpit_v4 {
        type ipv4_addr
        flags dynamic, timeout
        timeout 24h
        size {{ _setsize }}
    }
    counter tarpit_v6_drop  { packets 0 bytes 0 }
    counter tarpit_v6_addr  { packets 0 bytes 0 }
    set tarpit_v6 {
        type ipv6_addr
        flags dynamic, timeout
        timeout 24h
        size {{ _setsize }}
    }
{% if is_snowflake %}

    # ======== SNOWFLAKE BEGIN ========
    counter snowflake_v4    { packets 0 bytes 0 }
    counter snowflake_v6    { packets 0 bytes 0 }

    chain snowflake {
        # Snowflake (UDP)
        ip daddr $local_address_v4 udp dport {{ snowflake_port }} counter name "snowflake_v4" accept
        ip6 daddr $local_address_v6 udp dport {{ snowflake_port }} counter name "snowflake_v6" accept
    }
    # ======== SNOWFLAKE END ========
{% endif %}
{% if is_tor %}

    # ======== TOR DDOS BEGIN ========
    define tor_ports = { {{ tor_port }} }

    # the Tor inbound address/es
    set tor_v4 {
        type ipv4_addr
        elements = {
            $local_address_v4
        }
    }
    set tor_v6 {
        type ipv6_addr
        elements = {
            $local_address_v6
        }
    }

    # Tor authorities
    #   curl -s 'https://onionoo.torproject.org/summary?search=flag:authority' -o - | jq -cr '.relays[].a' | sort -V | xargs -r | sed 's/ /, /g'
    #   getent ahostsv4 snowflake-01.torproject.net. snowflake-02.torproject.net. | awk '{ print $1 }' | sort -uV | xargs -r | sed 's/ /, /g'
    set rule1_v4 {
        type ipv4_addr
        elements = {
            45.66.35.11, 66.111.2.131, 128.31.0.39, 131.188.40.189, 171.25.193.9,
            193.23.244.244, 199.58.81.140, 204.13.164.118, 216.218.219.41, 217.196.147.77,
            141.212.118.18, 193.187.88.42, 193.187.88.43, 193.187.88.44, 193.187.88.45, 193.187.88.46,
        }
    }
    #   curl -s 'https://onionoo.torproject.org/summary?search=flag:authority' -o - | jq -cr '.relays[].a' | sort -V | xargs -r | sed 's/ /, /g'
    #   getent ahostsv6 snowflake-01.torproject.net. snowflake-02.torproject.net. | awk '{ print $1 }' | sort -uV | xargs -r | sed 's/ /, /g'
    set rule1_v6 {
        type ipv6_addr
        elements = {
            2a09:61c0::1337, 2610:1c0:0:5::131, 2001:638:a000:4140::ffff:189, 2001:67c:289c::9,
            2001:678:558:1000::244, 2620:13:4000:6000::1000:118, 2001:470:164:2::2, 2a02:16a8:662:2203::1,
            2a0c:dd40:1:b::42, 2607:f018:600:8:be30:5bff:fef1:c6fa,
        }
    }

    # DDoS rule 1 - Tor authorities
    counter rule1_v4 { packets 0 bytes 0 }
    counter rule1_v6 { packets 0 bytes 0 }

    # DDoS rule 2 - rate limit 8 connections / min
    counter rule2_v4_rate { packets 0 bytes 0 }
    set rule2_v4_rate {
        type ipv4_addr . inet_service . ipv4_addr
        flags dynamic, timeout
        timeout 5m
        size {{ _setsize }}
    }
    counter rule2_v6_rate { packets 0 bytes 0 }
    set rule2_v6_rate {
        type ipv6_addr . inet_service . ipv6_addr
        flags dynamic, timeout
        timeout 5m
        size {{ _setsize }}
    }

    counter rule2_v4_drop { packets 0 bytes 0 }
    set rule2_v4_drop {
        type ipv4_addr . inet_service
        flags dynamic, timeout
        timeout 24h
        size {{ _setsize }}
    }
    counter rule2_v6_drop { packets 0 bytes 0 }
    set rule2_v6_drop {
        type ipv6_addr . inet_service
        flags dynamic, timeout
        timeout 24h
        size {{ _setsize }}
    }

    # DDoS rule 3 - rate limit 24 connections / hour
    counter rule3_v4_rate { packets 0 bytes 0 }
    set rule3_v4_rate {
        type ipv4_addr . inet_service . ipv4_addr
        flags dynamic, timeout
        timeout 150m
        size {{ _setsize }}
    }
    counter rule3_v6_rate { packets 0 bytes 0 }
    set rule3_v6_rate {
        type ipv6_addr . inet_service . ipv6_addr
        flags dynamic, timeout
        timeout 150m
        size {{ _setsize }}
    }

    counter rule3_v4_drop { packets 0 bytes 0 }
    set rule3_v4_drop {
        type ipv4_addr . inet_service
        flags dynamic, timeout
        timeout 24h
        size {{ _setsize }}
    }
    counter rule3_v6_drop { packets 0 bytes 0 }
    set rule3_v6_drop {
        type ipv6_addr . inet_service
        flags dynamic, timeout
        timeout 24h
        size {{ _setsize }}
    }

    # DDoS rule 4 - not more than 8 connections per remote to same Tor port
    counter rule4_v4 { packets 0 bytes 0 }
    set rule4_v4 {
        type ipv4_addr . inet_service . ipv4_addr
        flags dynamic
        size {{ _setsize }}
    }
    counter rule4_v6 { packets 0 bytes 0 }
    set rule4_v6 {
        type ipv6_addr . inet_service . ipv6_addr
        flags dynamic
        size {{ _setsize }}
    }

    # DDoS rule 5 - allow
    counter rule5_v4 { packets 0 bytes 0 }
    counter rule5_v6 { packets 0 bytes 0 }

    chain tor_v4 {
        # DDoS rule 1
        ip saddr @rule1_v4 counter name "rule1_v4" accept

        # --- DDoS rule 2 ---
        ip saddr & $network_v4_block . tcp dport @rule2_v4_drop \
            update @rule2_v4_drop { ip saddr & $network_v4_block . tcp dport } \
            counter name "rule2_v4_drop" drop

        meta l4proto tcp \
            add @rule2_v4_rate { ip saddr & $network_v4_block . tcp dport . ip daddr limit rate over 4/minute burst 8 packets } \
            update @rule2_v4_drop { ip saddr & $network_v4_block . tcp dport } \
            counter name "rule2_v4_rate" drop

        # --- DDoS rule 3 ---
        # Check and drop if already listed in the drop set
        ip saddr & $network_v4_block . tcp dport @rule3_v4_drop \
            update @rule3_v4_drop { ip saddr & $network_v4_block . tcp dport } \
            counter name "rule3_v4_drop" drop

        meta l4proto tcp \
            add @rule3_v4_rate { ip saddr & $network_v4_block . tcp dport . ip daddr limit rate over 24/hour burst 8 packets } \
            update @rule3_v4_drop { ip saddr & $network_v4_block . tcp dport } \
            counter name "rule3_v4_rate" drop

        # --- DDoS rule 4 ---
        update @rule4_v4 { ip saddr & $network_v4_block . tcp dport . ip daddr ct count over 8 } \
            counter name "rule4_v4" drop

        # --- DDoS rule 5 ---
        meta nfproto ipv4 counter name "rule5_v4" accept
    }

    chain tor_v6 {
        # DDoS rule 1
        ip6 saddr @rule1_v6 counter name "rule1_v6" accept

        # --- DDoS rule 2 ---
        ip6 saddr & $network_v6_block . tcp dport @rule2_v6_drop \
            update @rule2_v6_drop { ip6 saddr & $network_v6_block . tcp dport } \
            counter name "rule2_v6_drop" drop

        add @rule2_v6_rate { ip6 saddr & $network_v6_block . tcp dport . ip6 daddr limit rate over 4/minute burst 8 packets } \
            update @rule2_v6_drop { ip6 saddr & $network_v6_block . tcp dport } \
            counter name "rule2_v6_rate" drop

        # --- DDoS rule 3 ---
        ip6 saddr & $network_v6_block . tcp dport @rule3_v6_drop \
            update @rule3_v6_drop { ip6 saddr & $network_v6_block . tcp dport } \
            counter name "rule3_v6_drop" drop

        add @rule3_v6_rate { ip6 saddr & $network_v6_block . tcp dport . ip6 daddr limit rate over 24/hour burst 8 packets } \
            update @rule3_v6_drop { ip6 saddr & $network_v6_block . tcp dport } \
            counter name "rule3_v6_rate" drop

        # --- DDoS rule 4 ---
        update @rule4_v6 { ip6 saddr & $network_v6_block . tcp dport . ip6 daddr ct count over 8 } \
            counter name "rule4_v6" drop

        # --- DDoS rule 5 ---
        meta nfproto ipv6 counter name "rule5_v6" accept
    }
    # ======== TOR DDOS END ========

{% endif %}

    # Conntrack
    counter ct_x_syn    { packets 0 bytes 0 }
    counter ct_x_est    { packets 0 bytes 0 }
    counter ct_x_inv    { packets 0 bytes 0 }
    counter left        { packets 0 bytes 0 }

    chain prerouting {
        type filter hook prerouting priority -100; policy accept;

        tcp flags & (syn|rst|ack|fin) != syn ct state new counter name "ct_x_syn" drop
    }

    chain input {
        type filter hook input priority 0; policy drop;

        # Conntrack
        ct state established,related counter name "ct_x_est" accept
        ct state invalid counter counter name "ct_x_inv" drop

        # Loopback
        iifname "lo" accept

        # SSH
        tcp dport 22 ct state new counter accept

        # DHCP
        ip protocol udp udp sport 67 udp dport 68 counter accept
        ip6 nexthdr udp udp sport 547 udp dport 546 counter accept

        # ICMP
        counter jump icmp_filter

        # additional
        counter jump additional

        # Tarpit
        ip saddr & $network_v4_block @tarpit_v4 \
            update @tarpit_v4 { ip saddr & $network_v4_block } \
            counter name "tarpit_v4_drop" drop

        ip6 saddr & $network_v6_block @tarpit_v6 \
            update @tarpit_v6 { ip6 saddr & $network_v6_block } \
            counter name "tarpit_v6_drop" drop
{% if is_snowflake %}

        # Snowflake
        counter jump snowflake
{% endif %}
{% if is_tor %}

        # Tor
        ip daddr @tor_v4 tcp dport $tor_ports ct state new counter jump tor_v4
        ip6 daddr @tor_v6 tcp dport $tor_ports ct state new counter jump tor_v6
{% endif %}

        # Tarpit new
        meta l4proto tcp ip daddr $local_address_v4 ct state new \
            update @tarpit_v4 { ip saddr & $network_v4_block } \
            counter name "tarpit_v4_addr" drop

        meta l4proto tcp ip6 daddr $local_address_v6 ct state new \
            update @tarpit_v6 { ip6 saddr & $network_v6_block } \
            counter name "tarpit_v6_addr" drop

        counter name "left"
    }
}